# Statement for enabling the development environment
DEBUG = True

# Define the application directory
import os
BASE_DIR = os.path.abspath(os.path.dirname(__file__))

# set here the upload directory
UPLOAD_FOLDER = os.path.join(BASE_DIR, 'app/static')
SIGNATURE_FOLDER = os.path.join(BASE_DIR, 'app/protected')
ALLOWED_EXTENSIONS = set(['jpg', 'png'])

# Adoption listings (eraAdopt): photos are written in the eraAdopt upload folder
ADOPT_UPLOAD_FOLDER = os.path.abspath(os.path.join(os.path.dirname(BASE_DIR), 'uploads', 'eraAdopt'))
ADOPT_MAX_PHOTOS = 6
# Maximum request size (photos are reduced in the browser before upload, this is only a safeguard)
MAX_CONTENT_LENGTH = 20 * 1024 * 1024  # 20 MB

# Define the database - we are working with
SQLALCHEMY_DATABASE_URI = "mysql+mysqlconnector://{username}:{password}@{hostname}/{databasename}".format(
    username="<your username>",
    password="<your mysql password>",
    hostname="<your username>",
    databasename="<your username>$data",
)
SQLALCHEMY_POOL_RECYCLE = 299
SQLALCHEMY_TRACK_MODIFICATIONS = False

# application "from" address
FAWEB_MAILADDR='<email address>'

# Application threads. A common general assumption is
# using 2 per available processor cores - to handle
# incoming requests using one and performing background
# operations using the other.
#THREADS_PER_PAGE = 2

# Enable protection agains *Cross-site Request Forgery (CSRF)*
CSRF_ENABLED     = True

# Use a secure, unique and absolutely secret key for
# signing the data.
CSRF_SESSION_KEY = "<random string>"

# Secret key for signing cookies
SECRET_KEY = "<random string>"

# Single sign-on with the adoptions website (eraAdopt): session cookie shared
# between the association-era.org subdomains. eraAdopt must use the same
# SECRET_KEY and the same values below.
SESSION_COOKIE_DOMAIN = "association-era.org"
SESSION_COOKIE_NAME = "session"
